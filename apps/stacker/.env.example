# SvelteKit public env vars (PUBLIC_ prefix exposes to browser)
# Get Supabase values from: supabase status -o json
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Backend service URLs
PUBLIC_RETRIEVER_API_URL=http://localhost:8001
PUBLIC_PETDATA_API_URL=http://localhost:8002

# Module feature flags: comma-separated allow-list of enabled module ids.
# Unset or empty enables every registered module. Modules left out render
# greyed as "In development" and their /app/<id>/* routes return 404.
PUBLIC_ENABLED_MODULES="retriever"

# Stripe webhook (server-side only; never exposed to the browser)
# Endpoint: POST /api/webhooks/stripe
# Signing secret from the Stripe dashboard webhook config.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# Supabase service-role key: bypasses RLS to upsert public.subscriptions.
STRIPE_WEBHOOK_SUPABASE_SERVICE_KEY=your-service-role-key
# The webhook resolves the Supabase user id from the Stripe subscription/customer
# metadata.supabase_user_id, which must be set at checkout (checkout not yet built).
