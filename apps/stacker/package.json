{
  "name": "stacker",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "gen:types": "openapi-typescript ../../services/retriever/openapi.json -o src/lib/modules/retriever/api/types.generated.ts && openapi-typescript ../../services/petdata/openapi.json -o src/lib/modules/petdata/api/types.generated.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lucide/svelte": "^0.577.0",
    "@skeletonlabs/skeleton": "^3.0.0",
    "@skeletonlabs/skeleton-svelte": "^1.0.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.0.0",
    "marked": "^17.0.4",
    "stripe": "^18.5.0"
  }
}
