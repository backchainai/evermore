{
  "enabledPlugins": {
    "daedalus@backchain": true,
    "supabase@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "backchain": {
      "source": { "source": "github", "repo": "backchainai/daedalus" }
    },
    "claude-plugins-official": {
      "source": { "source": "github", "repo": "anthropics/claude-plugins-official" }
    },
    "astral-sh": {
      "source": { "source": "github", "repo": "astral-sh/claude-code-plugins" }
    }
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *event=APPROVE*)",
      "Bash(gh api *mergePullRequest*)",
      "Bash(gh api *addPullRequestReview*)",
      "Bash(gh api *submitPullRequestReview*)",
      "Bash(gh api *enablePullRequestAutoMerge*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard:*)",
      "mcp__plugin_github_github__merge_pull_request",
      "mcp__plugin_github_github__pull_request_review_write",
      "mcp__*__merge_pull_request",
      "mcp__*__pull_request_review_write"
    ]
  }
}
