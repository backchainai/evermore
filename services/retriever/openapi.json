{
  "components": {
    "schemas": {
      "AskRequest": {
        "description": "Request body for the ask endpoint.",
        "properties": {
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskResponse": {
        "description": "Response from the RAG ask endpoint.",
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "blocked": {
            "default": false,
            "title": "Blocked",
            "type": "boolean"
          },
          "blocked_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Blocked Reason"
          },
          "chunks_used": {
            "items": {
              "$ref": "#/components/schemas/ChunkWithScore"
            },
            "title": "Chunks Used",
            "type": "array"
          },
          "confidence_level": {
            "title": "Confidence Level",
            "type": "string"
          },
          "confidence_score": {
            "title": "Confidence Score",
            "type": "number"
          }
        },
        "required": [
          "answer",
          "chunks_used",
          "confidence_level",
          "confidence_score"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "Body_upload_document_api_v1_documents_upload_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_document_api_v1_documents_upload_post",
        "type": "object"
      },
      "ChunkWithScore": {
        "description": "A retrieved chunk with its similarity score.",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "section": {
            "title": "Section",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "title": {
            "default": "",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "content",
          "source",
          "section",
          "score"
        ],
        "title": "ChunkWithScore",
        "type": "object"
      },
      "ClearHistoryResponse": {
        "description": "Result of clearing conversation history.",
        "properties": {
          "deleted_count": {
            "title": "Deleted Count",
            "type": "integer"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "deleted_count",
          "message"
        ],
        "title": "ClearHistoryResponse",
        "type": "object"
      },
      "DocumentDeleteResponse": {
        "description": "Result of deleting a document.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "DocumentDeleteResponse",
        "type": "object"
      },
      "DocumentListResponse": {
        "description": "List of documents with total count.",
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentResponse"
            },
            "title": "Documents",
            "type": "array"
          }
        },
        "required": [
          "documents",
          "count"
        ],
        "title": "DocumentListResponse",
        "type": "object"
      },
      "DocumentResponse": {
        "description": "Single document metadata.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "file_size_bytes": {
            "title": "File Size Bytes",
            "type": "integer"
          },
          "file_type": {
            "title": "File Type",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_indexed": {
            "title": "Is Indexed",
            "type": "boolean"
          },
          "last_updated_at": {
            "format": "date-time",
            "title": "Last Updated At",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "filename",
          "title",
          "file_type",
          "file_size_bytes",
          "is_indexed",
          "created_at",
          "last_updated_at",
          "description"
        ],
        "title": "DocumentResponse",
        "type": "object"
      },
      "DocumentUploadResponse": {
        "description": "Result of uploading and indexing a document.",
        "properties": {
          "chunks_created": {
            "title": "Chunks Created",
            "type": "integer"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "filename",
          "title",
          "chunks_created",
          "message"
        ],
        "title": "DocumentUploadResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Health check response.",
        "properties": {
          "database": {
            "enum": [
              "connected",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "pgvector": {
            "enum": [
              "available",
              "unavailable"
            ],
            "title": "Pgvector",
            "type": "string"
          },
          "status": {
            "enum": [
              "healthy",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "database",
          "pgvector"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MessageHistoryResponse": {
        "description": "Paginated conversation history.",
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "title": "Messages",
            "type": "array"
          }
        },
        "required": [
          "messages",
          "count"
        ],
        "title": "MessageHistoryResponse",
        "type": "object"
      },
      "MessageResponse": {
        "description": "Single message in a conversation.",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "content",
          "created_at"
        ],
        "title": "MessageResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "AI-powered Q&A system for shelter volunteers",
    "title": "Retriever",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/ask": {
      "post": {
        "description": "Answer a question using RAG with conversation history.\n\nLoads recent conversation history, runs the RAG pipeline, and\npersists both the user question and assistant response.",
        "operationId": "ask_api_v1_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Ask",
        "tags": [
          "rag"
        ]
      }
    },
    "/api/v1/documents": {
      "get": {
        "description": "List all documents for the current tenant.",
        "operationId": "list_documents_api_v1_documents_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Documents",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/v1/documents/upload": {
      "post": {
        "description": "Upload and index a document (admin only).\n\nAccepts a multipart file upload, validates the file, indexes it\ninto the vector store, and creates a database record.",
        "operationId": "upload_document_api_v1_documents_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_api_v1_documents_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentUploadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Upload Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/v1/documents/{document_id}": {
      "delete": {
        "description": "Delete a document and its indexed chunks (admin only).",
        "operationId": "delete_document_api_v1_documents__document_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDeleteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Document",
        "tags": [
          "documents"
        ]
      },
      "get": {
        "description": "Get a single document by ID.",
        "operationId": "get_document_api_v1_documents__document_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/v1/history": {
      "delete": {
        "description": "Clear all conversation history for the authenticated user.",
        "operationId": "clear_history_api_v1_history_delete",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClearHistoryResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Clear History",
        "tags": [
          "messages"
        ]
      },
      "get": {
        "description": "Return recent conversation history for the authenticated user.",
        "operationId": "get_history_api_v1_history_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageHistoryResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get History",
        "tags": [
          "messages"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Health check endpoint.\n\nChecks database connectivity and pgvector extension availability.\nNever raises — returns degraded status on failure.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
