{
  // Wrangler config for the Worker that fronts the retriever FastAPI backend as
  // a Cloudflare Container (ADR 0008). The Worker is a thin router; all
  // application code lives in the container image and references no Cloudflare
  // primitives.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retriever",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",

  // Production hostname (ADR 0008). `custom_domain: true` has Cloudflare
  // provision the DNS record and edge route for this subdomain on the
  // `backchain.app` zone. Applying it needs a deploy token with Zone Workers
  // Routes + DNS edit on `backchain.app`; that token and the deploy itself are
  // the operator's step.
  "routes": [
    {
      "pattern": "retriever.evermore.backchain.app",
      "custom_domain": true
    }
  ],

  // One container, built from the existing multi-stage Dockerfile. The build
  // context is the service root (this directory), so the Dockerfile's
  // `COPY pyproject.toml ... src/ ...` paths resolve unchanged.
  "containers": [
    {
      "class_name": "RetrieverContainer",
      "image": "./Dockerfile",
      "max_instances": 3,
      "instance_type": "standard-1"
    }
  ],

  // Cloudflare Containers are backed by a Durable Object. The container class is
  // bound here and registered as a new SQLite-backed class in the migration
  // below (both are required by Cloudflare Containers).
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RetrieverContainer",
        "name": "RETRIEVER_CONTAINER"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RetrieverContainer"]
    }
  ],

  // Non-secret environment. The container binds 0.0.0.0:${PORT}.
  // Secrets (DATABASE_URL, LLM_GATEWAY_TOKEN, SUPABASE_URL, etc.) are injected
  // via `wrangler secret put <NAME>` / Wrangler secret bindings and forwarded
  // into the container by worker/index.ts. They are NEVER committed here.
  //
  // The retriever connects directly to the Supabase pooler via DATABASE_URL.
  // No Hyperdrive binding is configured: Hyperdrive in front of Supabase is
  // deferred to issue #109.
  //
  // ALLOWED_ORIGINS is the production CORS allow-list (not a secret). The
  // container's FastAPI CORS middleware reads it via pydantic-settings
  // (`allowed_origins`, comma-separated, parsed into `allowed_origins_list`);
  // worker/index.ts forwards it into the container. The portal origin is the
  // only production caller; `allow_credentials=True` forbids a `*` wildcard,
  // which config.py rejects.
  "vars": {
    "PORT": "8000",
    "ALLOWED_ORIGINS": "https://evermore.backchain.app"
  },

  // Observability is declarative in wrangler config: each deploy resets it to
  // the value committed here, so logging must live in config to persist across
  // deploys (issue #145). Invocation logs surface container boot errors and
  // Python tracebacks in the dashboard Logs and `wrangler tail`. Traces off.
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": false }
  }
}
